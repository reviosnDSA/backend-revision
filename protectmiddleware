import jwt from "jsonwebtoken"
import User from "../models/user.model.js"

export const protectRoute=async(req,res,next)=>{
  try {
    const token=req.cookies.jwt;
    if(!token){
      return res.status(401).json({message:"Unauthroized - No token provided"})
    }

    //decode the joken and verify it
    const decoded=jwt.verify(token,process.env.JWT_SECRET);
    if(!decoded){
      return res.status(401).json({message:"Unauthroized - Invalid token"})
    }

    const user= await User.findById(decoded.userId).select("-password")
    if(!user){
      return res.status(404).json({message:"User not found"})
    }
    req.user=user;
    next();
  } catch (error) {
    console.log("protect middleware error",error);
    res.status(500).json({message:"Internal server error"})
  }
}



⭕jwt tokens and cookies
import jwt from "jsonwebtoken"

export const generateToken=(userId,res)=>{
  const token=jwt.sign({userId},process.env.JWT_SECRET,{
    expiresIn:"7d"
  })
  
  res.cookie("jwt",token,{
    maxAge:7*24*60*60*1000,
    httpOnly:true,
    sameSite:"strict",
    secure:process.env.NODE_ENV !== "development"
  })
  return token;
}


⭕mongodb connection
import mongoose from "mongoose"
import dotenv from "dotenv"
dotenv.config();
export const connectDB=async ()=>{
  try {
    const conn=await mongoose.connect(process.env.MONGO_URL);
    console.log(`mongodb connected :${conn.connection.host}`)
  } catch (error) {
    console.log("mongodb connection error:",error);
  }
}

🌟
Imports Mongoose, a popular ODM (Object Data Modeling) library for MongoDB.
It simplifies interacting with MongoDB databases — instead of writing raw queries, you define models and use Mongoose’s API (find(), save(), etc.).

🌟dotenv.config()
Imports the dotenv package — used to load environment variables from a .env file into your Node.js process.
These variables are stored securely and not hardcoded into your code (for security & flexibility).
It loads all the variables from your .env file and makes them available in process.env.
